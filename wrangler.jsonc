{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blmf-chat-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEFAULT_YOUTUBE_CHANNEL": "",
    "PUBLIC_R2_BASE_URL": "https://chat.bluemoon.works",
    "R2_CURRENT_OBJECT_KEY": "comments.json",
    "R2_STATUS_OBJECT_KEY": "status.json",
    "DISCOVERY_INTERVAL_SECONDS": "300",
    "R2_FLUSH_INTERVAL_SECONDS": "15"
  },
  "secrets": {
    "required": ["YOUTUBE_API_KEY", "ADMIN_TOKEN"]
  },
  "r2_buckets": [
    {
      "binding": "COMMENTS_BUCKET",
      "bucket_name": "blmf-chat-relay"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_RELAY",
        "class_name": "YouTubeChatRelay"
      }
    ]
  },
  "exports": {
    "YouTubeChatRelay": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
