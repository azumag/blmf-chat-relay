{
  "name": "blmf-chat-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers relay that discovers the active YouTube livestream for a channel and publishes chat snapshots to R2.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
